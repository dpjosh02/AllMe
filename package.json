{
  "name": "allme",
  "version": "1.0.0",
  "description": "AllMe is a personal operating system for daily notes, calendar visibility, finance tracking, and progress monitoring.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "finance:fintable:dry-run": "tsx scripts/fintable-dry-run.ts",
    "finance:fintable:import": "tsx scripts/fintable-import.ts",
    "finance:categorize": "tsx scripts/finance-categorize.ts",
    "finance:test-data:seed": "tsx scripts/finance-seed-test-data.ts",
    "finance:test-data:clear": "tsx scripts/finance-clear-test-data.ts",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpjosh02/AllMe.git"
  },
  "keywords": [
    "personal-dashboard",
    "finance",
    "notes",
    "calendar"
  ],
  "author": "dpjosh02",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/dpjosh02/AllMe/issues"
  },
  "homepage": "https://github.com/dpjosh02/AllMe#readme",
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.6.2",
    "lucide-react": "^1.11.0",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^29.0.2",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
